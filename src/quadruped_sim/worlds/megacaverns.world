<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="megacaverna">

    <physics name="1ms" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.588235 0.588235 0.588235 1</ambient>
      <background>0.980392 0.980392 0.980392 1</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <!-- These lines must be added to each world in the repository in order to enable using sensors and spawning robots -->
    <!-- Adding manually some plugins, needed after adding sensors  -->
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="libgaz_publisher.so"
        name="GazPublisher">
    </plugin>

    <!-- Plugin to enable spawning models dynamically -->
    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for sensors  -->
    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <include>
      <static>true</static>
      <name>map</name>
      <pose>8 -47 1 0 0 0</pose>
      <uri>model://MegaCavern</uri>
    </include>

    <!-- robot 
    <include>
      <name>robot</name>
      <pose>0 0 1 0 0 0</pose>
      <uri>model://CERBERUS_ANYMAL_B_SENSOR_CONFIG_1</uri>
    </include> -->

  </world>
</sdf>
