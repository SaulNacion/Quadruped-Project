<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="simple_tunnel">

    <physics name="1ms" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <!-- 150/255 ~= 0.588235, 250/255 ~= 0.980392 -->
      <ambient>0.588235 0.588235 0.588235 1</ambient>
      <background>0.980392 0.980392 0.980392 1</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <!-- These lines must be added to each world in the repository in order to enable using sensors and spawning robots-->
    <!-- Adding manually some plugins, needed after adding sensors  -->
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="libgaz_publisher.so"
        name="GazPublisher">
    </plugin>

    <!-- Plugin to enable spawning models dynamically -->
    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for sensors  -->
    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Base de operaciones -->
    <include>
      <static>true</static>
      <name>base_station</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/subt_tunnel_staging_area</uri>
    </include>

    <!-- Fiducial de origen para reportes -->
    <include>
      <name>artifact_origin</name>
      <pose>10.0 0.0 0.0 0 0 0</pose>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Fiducial</uri>
    </include> 

    <!-- Baldosas del túnel -->
    <include><name>tile_1</name>  <uri>model://tunnel_tile_5</uri> <pose>20.0   0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_2</name>  <uri>model://tunnel_tile_5</uri> <pose>40.0   0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_3</name>  <uri>model://tunnel_tile_5</uri> <pose>60.0   0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_4</name>  <uri>model://tunnel_tile_5</uri> <pose>80.0   0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_5</name>  <uri>model://tunnel_tile_5</uri> <pose>100.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_6</name>  <uri>model://tunnel_tile_5</uri> <pose>120.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_7</name>  <uri>model://tunnel_tile_5</uri> <pose>140.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_8</name>  <uri>model://tunnel_tile_5</uri> <pose>160.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_9</name>  <uri>model://tunnel_tile_5</uri> <pose>180.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_10</name> <uri>model://tunnel_tile_5</uri> <pose>200.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_11</name> <uri>model://tunnel_tile_5</uri> <pose>220.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_12</name> <uri>model://tunnel_tile_5</uri> <pose>240.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_13</name> <uri>model://tunnel_tile_5</uri> <pose>260.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_14</name> <uri>model://tunnel_tile_5</uri> <pose>280.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_15</name> <uri>model://tunnel_tile_5</uri> <pose>300.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_16</name> <uri>model://tunnel_tile_5</uri> <pose>320.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_17</name> <uri>model://tunnel_tile_5</uri> <pose>340.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_18</name> <uri>model://tunnel_tile_5</uri> <pose>360.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_19</name> <uri>model://tunnel_tile_5</uri> <pose>380.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_20</name> <uri>model://tunnel_tile_5</uri> <pose>400.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_21</name> <uri>model://tunnel_tile_5</uri> <pose>420.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_22</name> <uri>model://tunnel_tile_5</uri> <pose>440.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_23</name> <uri>model://tunnel_tile_5</uri> <pose>460.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_24</name> <uri>model://tunnel_tile_5</uri> <pose>480.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_25</name> <uri>model://tunnel_tile_5</uri> <pose>500.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_26</name> <uri>model://tunnel_tile_5</uri> <pose>520.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_27</name> <uri>model://tunnel_tile_5</uri> <pose>540.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_28</name> <uri>model://tunnel_tile_5</uri> <pose>560.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_29</name> <uri>model://tunnel_tile_5</uri> <pose>580.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_30</name> <uri>model://tunnel_tile_5</uri> <pose>600.0  0.0 0.0 0 0 -1.570796</pose></include>
    <include><name>tile_31</name> <uri>model://tunnel_tile_5</uri> <pose>620.0  0.0 0.0 0 0 -1.570796</pose></include>

    <!-- Bloqueador final -->
    <include>
      <name>tile_32</name>
      <!-- <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Tunnel%20Tile%20Blocker</uri> -->
      <uri>model://Tunnel Tile Blocker</uri>
      <pose>631.0 0.0 0.0 0 0 0.0</pose>
    </include>

    <!-- robot -->
    <!-- <include>
      <name>robot</name>
      <pose>0 0 1 0 0 0</pose>
      <uri>model://CERBERUS_ANYMAL_B_SENSOR_CONFIG_1</uri>
    </include>  -->

  </world>
</sdf>
